/*****----- Configuration -----*****/
configuration {
    modi:                       "drun";
    font:                       "Rubik Bold 10";
    show-icons:                 true;
    icon-theme:                 "Reversal-dark";
    display-drun:               "";
    drun-display-format:        "{name}";
    sidebar-mode:               false;
}

@theme "/dev/null"


/*****----- Global Properties -----*****/
* {
    bg:                         #24273a;
    fg:                         #e8e8d3;
    accent:                     #89b4fa;
    button:                     #1c1c1c;
    selected:                   #363a4f;

    background-color:           @bg;
    text-color:                 @fg;
}


/*****----- Main Window -----*****/
window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;

    width:                      700px;
    height:                     400px;

    border:                     2px;
    border-color:               @accent;
    border-radius:              12px;

    background-color:           @bg;
}


/*****----- Main Box -----*****/
mainbox {
    enabled:                    true;
    spacing:                    0px;
    padding:                    0px;

    orientation:                horizontal;
    children:                   [ "imagebox", "contentbox" ];

    background-color:           transparent;
}


/*****----- Image -----*****/
imagebox {
    enabled:                    true;

    width:                      40%;
    padding:                    20px;

    background-color:            transparent;
    background-image:            url("~/.config/rofi/images/fondo.jpg", height);

    orientation:                vertical;
}


/*****----- Right Side -----*****/
contentbox {
    enabled:                    true;
    spacing:                    20px;
    padding:                    30px;

    orientation:                vertical;
    children:                   [ "inputbar", "listview" ];

    background-color:            transparent;
}


/*****----- Inputbar -----*****/
inputbar {
    enabled:                    true;

    spacing:                    10px;
    padding:                    12px;

    border-radius:              7px;

    background-color:            @button;
    text-color:                  @fg;

    children:                   [ "prompt", "entry" ];
}


/*****----- Prompt -----*****/
prompt {
    enabled:                    true;
    expand:                     false;

    padding:                    0px;

    background-color:            transparent;
    text-color:                  @fg;

    font:                       "Rubik Bold 10";
}


/*****----- Entry -----*****/
entry {
    enabled:                    true;
    expand:                     true;

    background-color:            transparent;
    text-color:                  @fg;

    cursor:                      text;

    placeholder:                "Search";
    placeholder-color:          @fg;
}


/*****----- Listview -----*****/
listview {
    enabled:                    true;

    columns:                    1;
    lines:                      8;

    cycle:                      true;
    dynamic:                    true;

    scrollbar:                  false;

    layout:                     vertical;

    spacing:                    8px;

    background-color:            transparent;
    text-color:                  @fg;
}


/*****----- Elements -----*****/
element {
    enabled:                    true;

    spacing:                    15px;
    padding:                    10px;

    border-radius:              7px;

    background-color:            transparent;
    text-color:                  @fg;

    cursor:                     pointer;
}


/*****----- Normal -----*****/
element normal.normal {
    background-color:            transparent;
    text-color:                  @fg;
}


/*****----- Selected -----*****/
element selected.normal {
    background-color:            @selected;
    text-color:                  @fg;
}


/*****----- Icon -----*****/
element-icon {
    background-color:            transparent;
    text-color:                  inherit;

    size:                       32px;

    cursor:                     inherit;
}


/*****----- Text -----*****/
element-text {
    background-color:            transparent;
    text-color:                  inherit;

    cursor:                     inherit;

    vertical-align:              0.5;
    horizontal-align:            0.0;
}
