{
    "layer": "top",
    "position": "top",
    "height": 15,

    "modules-left": [
        "custom/rofi",
        "custom/dolphin",
        "custom/nvim",
        "custom/kitty"
    ],

    "modules-center": [
        "hyprland/workspaces"
       
    ],

    "modules-right": [
        "clock",
        "cpu",
        "memory",
        "pulseaudio",
        "network",
        "battery"
    ],

    "hyprland/workspaces": {
        "format": "󰮯",
        "on-click": "activate",
        "sort-by-number": true
    },

    "custom/rofi": {
        "format": "",
        "on-click": "rofi -show drun",
        "tooltip": false
    },

    "custom/dolphin": {
        "format": "",
        "on-click": "dolphin",
        "tooltip": false
    },
    "custom/nvim": {
        "format": "",
        "on-click": "kitty -d ~ nvim",
        "tooltip": false
    },
     "custom/kitty": {
        "format": "",
        "on-click": "kitty",
        "tooltip": false
    },
    "clock": {
        "format": "󰥔 {:%H:%M}",
        "format-alt": "󰃭 {:%d/%m/%Y}"
    },

    "cpu": {
        "format": "󰍛 {usage}%"
    },

    "memory": {
        "format": " {}%"
    },

    "pulseaudio": {
        "format": "󰕾 {volume}%",
        "format-muted": "󰝟 Muted",
        "on-click": "pavucontrol"
    },

    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 Conectado",
        "format-disconnected": "󰤭 Sin conexión"
    },

    "battery": {
        "format": "󰁹 {capacity}%"
    }
}
